<rml>
<head>
    <title>Title</title>
    <link type="text/rcss" href="theme.rcss"/>
    <link type="text/rcss" href="title.rcss"/>
</head>
<body id="title">
    <!-- Over the title's own backdrop: only the lower half darkens, for the
         text to read against. -->
    <div id="shade"></div>
    <div id="press" class="hidden">
        <div id="press-text">Press Start</div>
    </div>
    <div id="menu" class="hidden">
        <img class="emblem" src="images/butterfly.png"/>
        <div class="rule"></div>
        <!-- The entries are built by miopan_rml_title.cpp. -->
        <div id="items"></div>
        <div class="rule"></div>
    </div>
    <div id="prompts" class="prompts"></div>
    <div id="confirm" class="confirm hidden">
        <div class="confirm-box">
            <p class="confirm-text"></p>
            <p class="confirm-note"></p>
            <div class="confirm-choices">
                <span id="confirm-yes" class="confirm-choice selectable">Yes</span>
                <span id="confirm-no" class="confirm-choice selectable">No</span>
            </div>
        </div>
    </div>
</body>
</rml>
