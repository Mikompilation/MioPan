/*
 * The in-game menu's pages, composed as the game composes them over its shoji
 * backdrop (miopan_rml_menu_art.h): the game's own plates, frames and icons
 * placed in its 640 x 448 picture, and RmlUi's text over them.  The stage is
 * that picture; its font-size is ten of the picture's pixels down, so the text
 * here is sized in em and follows the picture.  Each page adds its own sheet.
 *
 * The colours are the plates': the gold of their lettering, the ink on the
 * play-data sheet, the pale italic of the status plate's digits.
 */

.stage
{
    position: absolute;
    animation: 0.15s linear-in-out fade-in;
    opacity: 1;
    transition: opacity 0.12s linear-in-out;
}

/* Handing over to another page or closing the menu: the game fades its own
 * page out, and takes no input. */
.stage.closing
{
    opacity: 0;
}

.art
{
    position: absolute;
}

/* A holder for pieces placed on the stage.  It has to be positioned itself,
 * or RmlUi paints what it holds with the in-flow content, under every piece
 * of art placed before it; it has no size, so it takes no clicks. */
.layer
{
    position: absolute;
    left: 0;
    top: 0;
    width: 0;
    height: 0;
}

/* What Zero2Anim2D_CsrAnimCtrl() pulses: a scrollbar's arrows, a cursor's
 * triangles. */
.scroll-arrow
{
    position: absolute;
    cursor: pointer;
    animation: 0.5s cubic-in-out infinite alternate arrow-pulse;
}

.pulse
{
    animation: 0.5s cubic-in-out infinite alternate arrow-pulse;
}

@keyframes arrow-pulse
{
    from { opacity: 0.5; }
    to   { opacity: 1; }
}

/* ---- the gold lettering of the game's plates --------------------------- */

.menu-title,
.page-label
{
    position: absolute;
    font-style: italic;
    letter-spacing: 0.12em;
    color: #e3c27a;
    font-effect: outline(1dp #1c1006), glow(0dp 3dp 0dp 0dp #e8902e40);
}

.menu-title
{
    font-size: 2.6em;
    line-height: 1.2em;
    color: #f2d58e;
}

/* A long title kept on its plate: "Function Upgrades". */
.menu-title.long
{
    font-size: 2.1em;
    line-height: 1.5em;
    letter-spacing: 0.05em;
}

/* ---- the status plate (miopan_rml_menu_status.cpp) --------------------- */

.plate
{
    position: absolute;
}

.plate-num
{
    position: absolute;
    font-style: italic;
    font-size: 1.55em;
    line-height: 1.1em;
    color: #eee2c6;
    font-effect: outline(1dp #1c1006);
}

/* ---- button hints, where the game puts its own ------------------------ */

.menu-prompts
{
    position: absolute;
    text-align: right;
    font-size: 1.6em;
    font-style: italic;
    color: #e3c27a;
    font-effect: outline(1dp #1c1006);
}

.menu-prompts .prompt
{
    margin-left: 0.9em;
}

.menu-prompts .prompt:hover
{
    color: #fff2c8;
}

.menu-prompts .key
{
    font-style: normal;
    font-size: 0.75em;
    color: #f2ebe0;
    border-color: #b8913e;
    background-color: #1b1213e0;
}

/* ---- the game's windows ------------------------------------------------ */

/* DrawCmnWindow()'s glass, inside the gold frame miopan_rml_menu_art.cpp
 * lays over its edges from the game's own art: dark, but the page shows
 * through it, as the game's 0x66 lets it. */
.menu-window
{
    position: absolute;
    decorator: vertical-gradient(#1a120aa8 #050302c4);
}

/* DrawCmnTwoLineWindow()'s band between its rounded ends: black at 0.8. */
.menu-glass
{
    position: absolute;
    background-color: #000000cc;
}

.window-text
{
    position: absolute;
    font-size: 1.9em;
    line-height: 1.35em;
    color: #f2ebe0;
}

.window-choice
{
    position: absolute;
    text-align: center;
    font-size: 2em;
    line-height: 1.5em;
    font-style: italic;
    letter-spacing: 0.1em;
    color: #e3c27a;
    font-effect: outline(1dp #1c1006);
    cursor: pointer;
}

/* DrawCmnSelCsr()'s amber bar under the answer. */
.window-choice.selected
{
    color: #fff2c8;
    decorator: image(images/cursor_bar.png);
    font-effect: outline(1dp #3a1c04), glow(0dp 4dp 0dp 0dp #ffb04a70);
}

/* ---- list rows on the game's row frames -------------------------------- */

/* A line the height of the row frame, 33 of the game's pixels. */
.row-text
{
    position: absolute;
    font-size: 2.05em;
    line-height: 1.6;
    letter-spacing: 0.04em;
    color: #eadb9e;
    font-effect: outline(1dp #1c1006);
    white-space: nowrap;
}

.row-text.lit
{
    color: #fff1ea;
    font-effect: outline(1dp #4a1e08);
}

/* Centred in its box, as PrintMsg_Arrange() centres a line. */
.centred
{
    text-align: center;
}

/* A row's place, over its art, for the pointer. */
.row-hit
{
    position: absolute;
    cursor: pointer;
}

/* The caption window's line along the bottom of a list page. */
.caption-text
{
    position: absolute;
    font-size: 1.9em;
    line-height: 1.35;
    color: #f2ebe0;
}
