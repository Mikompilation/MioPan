/*
 * Sizes are in dp, and one dp is one pixel of the PS2's 640x448 screen scaled
 * to the game picture (miopan_rmlui.h).  The colours are the overlay's Crimson
 * Butterfly palette (miopan_ui.cpp): bone ink on near-black, dried-blood
 * rules, and crimson only on what has focus or is pressed.
 */

body
{
    display: flex;
    justify-content: center;
    align-items: center;
    width: 100%;
    height: 100%;
    /* Dim the game behind the panel. */
    background-color: #08050599;
    font-family: LatoLatin;
    font-size: 15dp;
    color: #ded3c4;
}

#panel
{
    display: block;
    width: 280dp;
    padding: 22dp 24dp 20dp;
    background-color: #120d0dfa;
    border: 1dp #4a2226;
    text-align: center;
}

h1
{
    display: block;
    margin-bottom: 8dp;
    font-size: 26dp;
    font-weight: bold;
}

p
{
    display: block;
    margin-bottom: 20dp;
    color: #7c6f66;
}

button
{
    display: inline-block;
    width: 96dp;
    padding: 6dp 0;
    background-color: #332224;
    border: 1dp #4a2226;
    tab-index: auto;
    focus: auto;
    nav: auto;
    cursor: pointer;
}

button:hover
{
    background-color: #6e1526;
}

button:focus
{
    border-color: #d42a3d;
}

button:active
{
    background-color: #a31428;
}
