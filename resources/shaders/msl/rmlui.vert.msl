#include <metal_stdlib>
#include <simd/simd.h>

using namespace metal;

struct type_RmlUiUniforms
{
    float4x4 uTransform;
    float4 uTranslation;
};

struct main0_out
{
    float4 out_var_TEXCOORD0 [[user(locn0)]];
    float2 out_var_TEXCOORD1 [[user(locn1)]];
    float4 gl_Position [[position]];
};

struct main0_in
{
    float2 in_var_TEXCOORD0 [[attribute(0)]];
    float4 in_var_TEXCOORD1 [[attribute(1)]];
    float2 in_var_TEXCOORD2 [[attribute(2)]];
};

vertex main0_out main0(main0_in in [[stage_in]], constant type_RmlUiUniforms& RmlUiUniforms [[buffer(0)]])
{
    main0_out out = {};
    out.gl_Position = RmlUiUniforms.uTransform * float4(in.in_var_TEXCOORD0 + RmlUiUniforms.uTranslation.xy, 0.0, 1.0);
    out.out_var_TEXCOORD0 = in.in_var_TEXCOORD1;
    out.out_var_TEXCOORD1 = in.in_var_TEXCOORD2;
    return out;
}

